# culos-init.service - primo boot: kernel CachyOS + pacchetti + auto-update

[Unit]
Description=CulOS first boot setup (CachyOS kernel + packages + auto-update)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/culos-postinstall.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
